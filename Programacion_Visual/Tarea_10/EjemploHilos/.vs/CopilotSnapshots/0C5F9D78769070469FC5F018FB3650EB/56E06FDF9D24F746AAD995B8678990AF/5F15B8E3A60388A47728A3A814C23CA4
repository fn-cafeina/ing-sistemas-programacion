using System;
using System.Diagnostics;
using System.Threading;
using System.Windows.Forms;

namespace EjemploHilos
{
    public partial class EjemploHilos : Form
    {
        private PerformanceCounter contadorCpu;
        private string textoCpuUltimo = "0%";
        private Thread hiloTrabajador;
        private volatile bool cancelarTrabajo = false;

        public EjemploHilos()
        {
            InitializeComponent();
        }

        private void dateTimePicker1_ValueChanged(object sender, EventArgs e) { }

        private void timer1_Tick(object sender, EventArgs e)
        {
            lblHora.Text = DateTime.Now.ToString("HH:mm:ss");
        }

        private void EjemploHilos_Load(object sender, EventArgs e)
        {
            lblHora.Text = DateTime.Now.ToString("HH:mm:ss");
            timer1.Start();

            try
            {
                contadorCpu = new PerformanceCounter("Processor", "% Processor Time", "_Total");
                contadorCpu.NextValue();
            }
            catch
            {
                contadorCpu = null;
            }
        }

        private void lblHora_Click(object sender, EventArgs e) { }

        private void button1_Click(object sender, EventArgs e)
        {
            button1.Enabled = false;
            progressBar1.Value = 0;
            cancelarTrabajo = false;

            hiloTrabajador = new Thread(() =>
            {
                if (contadorCpu != null)
                {
                    contadorCpu.NextValue();
                }

                for (int i = 0; i <= 100; i++)
                {
                    if (cancelarTrabajo) break;

                    Thread.Sleep(50);

                    if (contadorCpu != null && i % 5 == 0)
                    {
                        try
                        {
                            float cpu = contadorCpu.NextValue();
                            textoCpuUltimo = Math.Round(cpu, 1).ToString() + "%";
                        }
                        catch { }
                    }

                    this.Invoke((Action)(() =>
                    {
                        progressBar1.Value = Math.Min(100, Math.Max(0, i));
                        lblCpu.Text = "CPU: " + textoCpuUltimo;
                    }));
                }

                this.Invoke((Action)(() =>
                {
                    button1.Enabled = true;
                }));
            });

            hiloTrabajador.IsBackground = true;
            hiloTrabajador.Start();
        }

        private void progressBar1_Click(object sender, EventArgs e) { }

        private void EjemploHilos_FormClosing(object sender, FormClosingEventArgs e)
        {
            // request cancellation and wait shortly for thread to finish
            cancelarTrabajo = true;

            try
            {
                if (hiloTrabajador != null && hiloTrabajador.IsAlive)
                {
                    hiloTrabajador.Join(500);
                }
            }
            catch { }

            try
            {
                contadorCpu?.Dispose();
            }
            catch { }
        }
    }
}
